# Maintainer: Riflan Ahmed
#
# AUR package for mpc-rv. Built from the release tag; uses Arch's own gtk4 and mpv.
# After changing this file, regenerate .SRCINFO:  makepkg --printsrcinfo > .SRCINFO

pkgname=mpc-rv
pkgver=1.0.5
pkgrel=1
pkgdesc='Unofficial Rust rewrite of Media Player Classic - Home Cinema, with libmpv and GTK4'
arch=('x86_64' 'aarch64')
url='https://github.com/riflan0ahmed/mpc-revamp'
license=('GPL-3.0-or-later')
depends=('gtk4' 'mpv' 'glib2' 'cairo' 'pango' 'gdk-pixbuf2' 'libglvnd' 'libgcc' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo' 'git')
optdepends=('libdvdcss: play encrypted DVDs'
            'v4l-utils: capture devices'
            'dvb-tools: scan for DVB TV channels (Navigate > Tuner Scan)')
options=('!debug') # a release build has no debug symbols to split off
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
    cd mpc-revamp/mpc-rv
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd mpc-revamp/mpc-rv
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd mpc-revamp/mpc-rv
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release
}

package() {
    cd mpc-revamp
    sh packaging/install.sh mpc-rv/target/release/mpc-rv "$pkgdir/usr"
}
